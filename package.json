{
  "name": "tanya-and-the-cat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:level": "node scripts/measure-jumps.mjs && node scripts/audit-v3.mjs && node scripts/validate-collisions.mjs && node scripts/validate-recovery.mjs && node scripts/validate-scooter-lanes.mjs",
    "test:presentation": "node scripts/check-presentation.mjs",
    "level:overview": "node scripts/overview.mjs",
    "test:background": "node scripts/check-winter-background.mjs",
    "test:environment": "node scripts/check-winter-environment.mjs",
    "test:fatigue": "node scripts/check-fatigue.mjs",
    "test:collectible-trust": "node scripts/audit-v3.mjs && node scripts/check-collectible-trust.mjs",
    "test:character:context": "node scripts/check-tanya-context.mjs",
    "test:character": "node scripts/check-tanya.mjs",
    "test:character:production": "node scripts/check-tanya-production.mjs",
    "test:character:framing": "node scripts/check-tanya-framing.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
